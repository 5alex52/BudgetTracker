# Application environment file template

# Security
SECRET_KEY={{ secret_key }}
POSTGRES_PASSWORD={{ postgres_password }}

# Environment
ENVIRONMENT={{ app_environment }}

# Public domain (used by docker-compose.prod.yml for FRONTEND_URL, OAUTH_RETURN_URL, CORS_ORIGINS)
DOMAIN={{ app_domain }}
FRONTEND_URL=https://{{ app_domain }}
OAUTH_RETURN_URL=https://{{ app_domain }}/
CORS_ORIGINS=["https://{{ app_domain }}"]

# Database
POSTGRES_USER={{ postgres_user }}
POSTGRES_DB={{ postgres_db }}
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT={{ redis_port }}

# Backend
BACKEND_HOST_PORT={{ backend_port }}
FRONTEND_HOST_PORT={{ frontend_port }}
LOG_LEVEL={{ backend_log_level }}

# Frontend
VITE_API_PROXY_TARGET=http://backend:8000
