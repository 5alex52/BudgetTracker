# Шаблон переменных окружения для docker compose.
#   cp .env.example .env
# Значения по умолчанию те же, что в docker-compose.yml, поэтому .env можно не создавать.
# Перед публикацией сервиса наружу обязательно задайте SECRET_KEY и POSTGRES_PASSWORD.

# --- приложение ---
# LOCAL | DEV | TEST | PROD (PROD включает secure-cookies, нужен HTTPS)
ENVIRONMENT=LOCAL
LOG_LEVEL=INFO
SECRET_KEY=change-me-please
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- postgres ---
POSTGRES_DB=budgettracker
POSTGRES_USER=budget
POSTGRES_PASSWORD=budget
POSTGRES_HOST_PORT=5432

# --- redis ---
REDIS_HOST_PORT=6379

# --- rabbitmq (используется только профилем workers) ---
RABBIT_USER=guest
RABBIT_PASSWORD=guest
RABBITMQ_HOST_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# --- сервисы ---
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=5173
# vite проксирует /api на backend по имени сервиса в docker-сети
VITE_API_PROXY_TARGET=http://backend:8000
# применять alembic-миграции при старте backend-контейнера
RUN_MIGRATIONS=true
# адреса фронтенда для CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
