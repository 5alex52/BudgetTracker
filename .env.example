# Environment variable template for docker compose.
#   cp .env.example .env
# All parameters already have defaults directly in docker-compose*.yml,
# so this file is optional: it exists to override specific values.
# For the prod stack you must set SECRET_KEY and POSTGRES_PASSWORD.

# --- application ---
# LOCAL | DEV | TEST | PROD (PROD enables secure cookies, requires HTTPS)
ENVIRONMENT=LOCAL
LOG_LEVEL=INFO
# JWT signing key — replace with a long random string
SECRET_KEY=change-me-please
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- host ports ---
# All *_HOST_PORT values below override the published port; compose has
# defaults, the file is only needed to change them (e.g. on port conflicts).

# --- postgres ---
POSTGRES_DB=budgettracker
POSTGRES_USER=budget
POSTGRES_PASSWORD=budget
POSTGRES_HOST_PORT=5432
# Test database for pytest: inside the docker network it is the same postgres
# container, so only its published port is configured separately (not published right now).
TEST_POSTGRES_HOST_PORT=5432

# --- redis ---
REDIS_HOST_PORT=6379

# --- rabbitmq (used only by the workers profile) ---
RABBIT_USER=guest
RABBIT_PASSWORD=guest
RABBITMQ_HOST_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# --- services ---
# The backend host port is only needed for direct requests (http://localhost:8000/docs)
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=5173
# vite proxies /api to the backend by service name in the docker network
# (needed only for the dev stack; in the prod stack nginx proxies /api)
VITE_API_PROXY_TARGET=http://backend:8000
# apply alembic migrations when the backend container starts
RUN_MIGRATIONS=true
# frontend addresses for CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- OAuth and frontend address for emails/redirects ---
# In the prod stack only the frontend is exposed (FRONTEND_HOST_PORT:80 via nginx),
# so for a real domain these addresses must be replaced with the external https address.
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_RETURN_URL=http://localhost:5173/
FRONTEND_URL=http://localhost:5173

# --- optional integrations (features stay disabled while the values are empty) ---
# Telegram bot token from @BotFather: subscription reminders + Telegram Mini App login
TELEGRAM_BOT_TOKEN=
# Web Push keys for browser notifications: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@budgettracker.local
# Etherscan API key: enables EVM balance-history backfill (current balance works without it)
CRYPTO_ETHERSCAN_API_KEY=

# --- seed scripts ---
# The variables below are picked up by the backend container (and only it: their
# values must be added to the service's environment block, as they are not passed by default):
#   docker compose exec backend python -m scripts.seed_demo
#   docker compose exec backend python -m scripts.seed_admin
# DEMO_USER_EMAIL=demo@budgettracker.local
# DEMO_USER_PASSWORD=demo12345
# ADMIN_USER_EMAIL=admin@budgettracker.local
# ADMIN_USER_PASSWORD=admin12345
