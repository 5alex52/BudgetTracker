# Шаблон переменных окружения для docker compose.
#   cp .env.example .env
# Все параметры уже имеют значения по умолчанию прямо в docker-compose*.yml,
# поэтому файл не обязателен: он нужен, чтобы переопределить конкретные значения.
# Для прод-стека обязательно задайте SECRET_KEY и POSTGRES_PASSWORD.

# --- приложение ---
# LOCAL | DEV | TEST | PROD (PROD включает secure-cookies, нужен HTTPS)
ENVIRONMENT=LOCAL
LOG_LEVEL=INFO
# подпись JWT — замените на длинную случайную строку
SECRET_KEY=change-me-please
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- порты хоста ---
# Все *_HOST_PORT ниже переопределяют публикуемый порт; в compose есть значения
# по умолчанию, файл нужен только чтобы сменить их (например, при конфликте портов).

# --- postgres ---
POSTGRES_DB=budgettracker
POSTGRES_USER=budget
POSTGRES_PASSWORD=budget
POSTGRES_HOST_PORT=5432
# Тестовая БД для pytest: в docker-сети это тот же контейнер postgres,
# поэтому отдельно настраивается только публикуемый им порт (сейчас не публикуется).
TEST_POSTGRES_HOST_PORT=5432

# --- redis ---
REDIS_HOST_PORT=6379

# --- rabbitmq (используется только профилем workers) ---
RABBIT_USER=guest
RABBIT_PASSWORD=guest
RABBITMQ_HOST_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# --- сервисы ---
# порт backend на хосте нужен только для прямых запросов (http://localhost:8000/docs)
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=5173
# vite проксирует /api на backend по имени сервиса в docker-сети
# (нужно только dev-стеку; в prod-стеке /api проксирует nginx)
VITE_API_PROXY_TARGET=http://backend:8000
# применять alembic-миграции при старте backend-контейнера
RUN_MIGRATIONS=true
# адреса фронтенда для CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- OAuth и адрес фронтенда для писем/редиректов ---
# В прод-стеке наружу опубликован только фронтенд (FRONTEND_HOST_PORT:80 через nginx),
# поэтому для реального домена эти адреса нужно заменить на внешний https-адрес.
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_RETURN_URL=http://localhost:5173/
FRONTEND_URL=http://localhost:5173

# --- скрипты наполнения ---
# Переменные ниже подхватывает контейнер backend (и только он: значения для них
# нужно добавить в блок environment сервиса, т.к. по умолчанию они не передаются):
#   docker compose exec backend python -m scripts.seed_demo
#   docker compose exec backend python -m scripts.seed_admin
# DEMO_USER_EMAIL=demo@budgettracker.local
# DEMO_USER_PASSWORD=demo12345
# ADMIN_USER_EMAIL=admin@budgettracker.local
# ADMIN_USER_PASSWORD=admin12345
