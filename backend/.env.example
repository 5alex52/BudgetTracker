# Шаблон .env для backend.
#
# Приложению эти значения НЕ нужны: docker compose передаёт переменные контейнерам
# напрямую (см. x-backend-env в docker-compose.yml / docker-compose.prod.yml), а этот
# файл — только справка по поддерживаемым переменным и их значениям по умолчанию.
# Если положить его рядом с кодом как backend/.env, он будет прочитан pydantic-settings.
#
# Значения ниже описывают запуск внутри docker-сети, где хосты называются по именам
# сервисов. Для запуска с хоста их пришлось бы заменить на localhost — но такой режим
# не поддерживается: приложение запускается только через docker compose.

ENVIRONMENT=LOCAL
LOG_LEVEL=INFO

# postgres
POSTGRES_DB=budgettracker
POSTGRES_USER=budget
POSTGRES_PASSWORD=budget
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# база, в которой pytest создаёт временные БД (сама БД будет создана тестами)
TEST_POSTGRES_DB=budgettracker
TEST_POSTGRES_USER=budget
TEST_POSTGRES_PASSWORD=budget
TEST_POSTGRES_HOST=postgres
TEST_POSTGRES_PORT=5432

# auth
SECRET_KEY=change-me-please
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# redis / rabbitmq
REDIS_HOST=redis
REDIS_PORT=6379

RABBIT_HOST=rabbitmq
RABBIT_PORT=5672
# значения совпадают с x-backend-env в docker-compose.yml (корневой .env.example)
RABBIT_USER=user
RABBIT_PASSWORD=password

CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
CORS_HEADERS=["Content-Type", "Set-Cookie", "Access-Control-Allow-Headers", "Access-Control-Allow-Origin", "Authorization"]
CORS_METHODS=["GET", "POST", "OPTIONS", "DELETE", "PATCH", "PUT"]

# доступы администратора / демо-данных (scripts.seed_admin, scripts.seed_demo)
# стандартные значения: admin@example.com / admin12345 и demo@example.com / demo12345
# ADMIN_USER_EMAIL=admin@example.com
# ADMIN_USER_PASSWORD=admin12345
# DEMO_USER_EMAIL=demo@example.com
# DEMO_USER_PASSWORD=demo12345

# billing (оплата)
# mock — провайдер-заглушка, всегда подтверждает платёж; stripe и crypto — точки подключения.
# Без ключей stripe/crypto отвечают 503, тихого отката на mock нет.
BILLING_PROVIDER=mock
BILLING_CURRENCY=USD
BILLING_RETURN_URL=http://localhost:5173/settings/payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CRYPTO_API_KEY=
CRYPTO_WEBHOOK_SECRET=

# oauth (провайдеры пока заглушки — пустые значения просто отключают кнопки входа)
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_YANDEX_CLIENT_ID=
OAUTH_YANDEX_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_RETURN_URL=http://localhost:5173/

# адрес фронтенда для писем и редиректов
FRONTEND_URL=http://localhost:5173
