# .env template for the backend.
#
# The app does NOT need these values: docker compose passes variables to the containers
# directly (see x-backend-env in docker-compose.yml / docker-compose.prod.yml); this
# file is only a reference of supported variables and their defaults.
# If placed next to the code as backend/.env, it will be read by pydantic-settings.
#
# The values below describe a run inside the docker network, where hosts are named after
# the services. Running from the host would require replacing them with localhost — but that
# mode is not supported: the app runs only via docker compose.

ENVIRONMENT=LOCAL
LOG_LEVEL=INFO

# postgres
POSTGRES_DB=budgettracker
POSTGRES_USER=budget
POSTGRES_PASSWORD=budget
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# database where pytest creates temporary DBs (the DB itself is created by the tests)
TEST_POSTGRES_DB=budgettracker
TEST_POSTGRES_USER=budget
TEST_POSTGRES_PASSWORD=budget
TEST_POSTGRES_HOST=postgres
TEST_POSTGRES_PORT=5432

# auth
SECRET_KEY=change-me-please
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# redis / rabbitmq
REDIS_HOST=redis
REDIS_PORT=6379

RABBIT_HOST=rabbitmq
RABBIT_PORT=5672
# values match x-backend-env in docker-compose.yml (root .env.example)
RABBIT_USER=user
RABBIT_PASSWORD=password

CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
CORS_HEADERS=["Content-Type", "Set-Cookie", "Access-Control-Allow-Headers", "Access-Control-Allow-Origin", "Authorization"]
CORS_METHODS=["GET", "POST", "OPTIONS", "DELETE", "PATCH", "PUT"]

# admin / demo-data credentials (scripts.seed_admin, scripts.seed_demo)
# defaults: admin@example.com / admin12345 and demo@example.com / demo12345
# ADMIN_USER_EMAIL=admin@example.com
# ADMIN_USER_PASSWORD=admin12345
# DEMO_USER_EMAIL=demo@example.com
# DEMO_USER_PASSWORD=demo12345

# oauth (GitHub login; empty values simply disable the login button)
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_RETURN_URL=http://localhost:5173/

# frontend URL for emails and redirects
FRONTEND_URL=http://localhost:5173

# optional integrations (features stay disabled while the values are empty)
# Telegram bot token from @BotFather: subscription reminders + Telegram Mini App login
TELEGRAM_BOT_TOKEN=
# Web Push keys for browser notifications: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@budgettracker.local
# Etherscan API key: enables EVM balance-history backfill (current balance works without it)
CRYPTO_ETHERSCAN_API_KEY=
